---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { SITE } from '../consts';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const articles = (await getCollection('articles'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);
---

<BaseLayout>
  <div class="container">
    <section class="hero">
      <p class="eyebrow">{SITE.author}</p>
      <h1 class="hero-title">{SITE.tagline}</h1>
      <p class="hero-intro">
        Hi — I'm {SITE.author}. This is where I keep slow notes on what I'm
        learning: mostly AI and the way it bends how we build software, with
        the occasional detour into design and craft. Short pieces, written to
        figure things out, not to perform.
      </p>
    </section>

    <section class="latest">
      <div class="latest-header">
        <h2 class="latest-title">Latest</h2>
        <a class="latest-link" href={`${base}/articles/`}>All articles →</a>
      </div>

      <div class="article-list">
        {articles.map((article) => (
          <ArticleCard
            href={`${base}/articles/${article.id}/`}
            title={article.data.title}
            subtitle={article.data.subtitle}
            category={article.data.category}
            pubDate={article.data.pubDate}
          />
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .hero {
    padding: 2rem 0 3.5rem;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 2rem;
  }
  .hero-title {
    font-family: var(--font-hand);
    font-size: clamp(2.2rem, 1.6rem + 2.2vw, 3rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: 0;
    margin: 0.4rem 0 1rem;
    color: var(--color-text);
  }
  .hero-intro {
    font-family: var(--font-hand);
    font-size: 1.25rem;
    line-height: 1.55;
    color: var(--color-text-muted);
    margin: 0;
    max-width: 50ch;
  }

  .latest-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 0.5rem;
  }
  .latest-title {
    font-family: var(--font-hand);
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: 0;
    text-transform: none;
    color: var(--color-text-muted);
    margin: 0;
  }
  .latest-link {
    font-family: var(--font-hand);
    font-size: 1.05rem;
    color: var(--color-text-muted);
    text-decoration: none;
  }
  .latest-link:hover { color: var(--color-accent); }
</style>
