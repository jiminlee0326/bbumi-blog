---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const articles = (await getCollection('articles'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title="Articles"
  description="All articles."
>
  <div class="container">
    <header class="page-header">
      <p class="eyebrow">Articles</p>
      <h1 class="page-title">Everything I've written here</h1>
      <p class="page-intro">
        Ordered newest first. Categories sit alongside each piece so you can
        skim to whatever you're in the mood for.
      </p>
    </header>

    <div class="article-list">
      {articles.length === 0 && (
        <p class="muted">No articles yet.</p>
      )}
      {articles.map((article) => (
        <ArticleCard
          href={`${base}/articles/${article.id}/`}
          title={article.data.title}
          subtitle={article.data.subtitle}
          category={article.data.category}
          pubDate={article.data.pubDate}
        />
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .page-header {
    margin: 1rem 0 2.5rem;
    padding-bottom: 1.6rem;
    border-bottom: 1px solid var(--color-border);
  }
  .page-title {
    font-family: var(--font-sans);
    font-size: clamp(1.6rem, 1.2rem + 1.2vw, 2rem);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.015em;
    margin: 0.5rem 0 0.8rem;
  }
  .page-intro {
    font-family: var(--font-serif);
    font-size: 1.02rem;
    color: var(--color-text-muted);
    line-height: 1.65;
    margin: 0;
    max-width: 56ch;
  }
</style>
