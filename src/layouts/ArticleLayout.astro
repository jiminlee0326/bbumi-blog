---
import BaseLayout from './BaseLayout.astro';
import ShareSection from '../components/ShareSection.astro';

interface Props {
  title: string;
  subtitle?: string;
  category: string;
  pubDate: Date;
  description?: string;
  heroImage?: string;
}

const { title, subtitle, category, pubDate, description, heroImage } = Astro.props;

const dateLabel = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const heroSrc = heroImage
  ? (heroImage.startsWith('http')
      ? heroImage
      : `${base}${heroImage.startsWith('/') ? heroImage : `/${heroImage}`}`)
  : undefined;

const shareUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
---

<BaseLayout
  title={title}
  description={description ?? subtitle}
  image={heroSrc}
  type="article"
  publishedTime={pubDate}
>
  <article class="container">
    <header class="article-header">
      <p class="eyebrow">{category}</p>
      <h1 class="article-title">{title}</h1>
      {subtitle && <p class="article-subtitle">{subtitle}</p>}
      <p class="article-date">
        <time datetime={pubDate.toISOString()}>{dateLabel}</time>
      </p>
    </header>

    {heroSrc && (
      <figure class="hero">
        <img src={heroSrc} alt="" loading="eager" />
      </figure>
    )}

    <div class="prose">
      <slot />
    </div>

    <ShareSection title={title} url={shareUrl} />
  </article>
</BaseLayout>

<style>
  .article-header { margin: 0.5rem 0 2rem; }
  .article-title {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 1.3rem + 1.6vw, 2.4rem);
    font-weight: 700;
    line-height: 1.18;
    letter-spacing: -0.018em;
    margin: 0.4rem 0 0.5rem;
    color: var(--color-text);
  }
  .article-subtitle {
    font-family: var(--font-sans);
    font-size: 1.12rem;
    line-height: 1.55;
    color: var(--color-text-muted);
    margin: 0 0 0.9rem;
  }
  .article-date {
    font-family: var(--font-sans);
    font-size: 0.82rem;
    color: var(--color-text-faint);
    margin: 0;
  }
  .hero {
    margin: 0 0 2.4rem;
  }
  .hero img {
    width: 100%;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
  }
</style>
