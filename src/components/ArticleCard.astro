---
interface Props {
  href: string;
  title: string;
  subtitle?: string;
  category: string;
  pubDate: Date;
}

const { href, title, subtitle, category, pubDate } = Astro.props;

const dateLabel = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<a href={href} class="card">
  <div class="meta">
    <span class="eyebrow">{category}</span>
    <span class="dot" aria-hidden="true">·</span>
    <time class="date" datetime={pubDate.toISOString()}>{dateLabel}</time>
  </div>
  <h3 class="title">{title}</h3>
  {subtitle && <p class="subtitle">{subtitle}</p>}
</a>

<style>
  .card {
    display: block;
    padding: 1.4rem 0;
    border-bottom: 1px solid var(--color-border);
    text-decoration: none;
    color: inherit;
    transition: opacity var(--transition);
  }
  .card:hover { opacity: 1; }
  .card:hover .title { color: var(--color-accent); }

  .meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.4rem;
  }
  .dot { color: var(--color-text-faint); }
  .date {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    color: var(--color-text-muted);
  }

  .title {
    font-family: var(--font-sans);
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.01em;
    margin: 0.1em 0 0.35em;
    color: var(--color-text);
    transition: color var(--transition);
  }
  .subtitle {
    font-family: var(--font-serif);
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    margin: 0;
  }
</style>
